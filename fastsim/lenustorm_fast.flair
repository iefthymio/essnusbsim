# flair project file
Version: 300
Mode: fluka
md5: 66d8dfe8b81ca727bbdc3317965e1ddf
Input:
TITLE
*Set the defaults for precision simulations
DEFAULTS PRECISIO
#define ppion 0.7
#define ring_straight =75*100
#define muon_decay =5*1000*100
#define decay_tunnel '=ring_straight + muon_decay'
#define decay_rad 3000
*Define the beam characteristics
BEAM PION+ =ppion 0,, -5.0 -5.0 1.0
DISCARD , -NEUTRIE -NEUTRIM -ANEUTRIM
*Define the beam position
BEAMPOS , 0 0 0
GEOBEGIN COMBNAME
*Black body
SPH blkbody 0.0 0.0 0.0 '=decay_tunnel + 20000'
*Void sphere
SPH void 0.0 0.0 0.0 '=decay_tunnel + 9000'
*Pion decay tube
ZCC pdecay 0.0 0.0 =decay_rad
XYP sossec 1.0
XYP eossec =ring_straight
XYP eomdec1 =decay_tunnel
XYP eomdec2 =decay_tunnel+10
RCC neardet 0 0 =decay_tunnel+20 0 0 10.0 10000
END
*Black hole
REGION BLKBODY 5
	+blkbody -void
*Void around
REGION VOID 5
	+void -(+pdecay -sossec +eomdec2) -neardet  
*Pion decay
REGION PIDEC
	+pdecay -sossec +eossec 
	@select=1
REGION MUDEC
	+pdecay -eossec  +eomdec1 
REGION ENDDET
	+pdecay -eomdec1 +eomdec2 
REGION LEMOND
	+neardet 
END
GEOEND
*..+....1....+....2....+....3....+....4....+....5....+....6....+....7..
ASSIGNMA , BLCKHOLE BLKBODY
ASSIGNMA , VACUUM VOID
ASSIGNMA , VACUUM PIDEC
ASSIGNMA , VACUUM MUDEC
ASSIGNMA , VACUUM ENDDET
ASSIGNMA , HELIUM LEMOND
*Set the random number seed
RANDOMIZ , 1.0
*Set the number of primary histories to be simulated in the run
START , 100000
USRBDX SoSSPi 98 PION+ -21 VOID PIDEC,, 1.0 0.500 100
USRBDX EoSSPi 98 PION+ -22 PIDEC MUDEC,, 1.00 0.500 100
USRBDX EoSSMu 99 MUON+ -23 PIDEC MUDEC,, 1.5 0.050 100
USRBDX EoSSNuMu 99 NEUTRIM -24 PIDEC MUDEC,, 1.5 0.050 100
USRBDX NSTMu 99 MUON+ -25 MUDEC ENDDET,, 1.5 0.050 100
USRBDX NSTEl 99 ELECTRON -26 MUDEC ENDDET,, 1.5 0.050 100
USRBDX NSTNuMu 99 NEUTRIM -27 MUDEC ENDDET,, 1.5 0.050 100
USRBDX NSTANuMu 99 ANEUTRIM -28 MUDEC ENDDET,, 1.5 0.050 100
USRBDX NSTNuE 99 NEUTRIE -29 MUDEC ENDDET,, 1.5 0.050 100
USRBDX NDNue 98 NEUTRIE -30 VOID LEMOND,, 1.5 0.050 100
USRBDX NDANuMu 98 ANEUTRIM -31 VOID LEMOND,, 1.5 0.050 100
USRBIN NuMu 10 NEUTRIM -97 300 300 =decay_tunnel -300 -300 0 100 100 100
USRBIN Pions 10 PION+ -98 100 100 =ring_straight+100 -100 -100 0 100 100 100
USRBIN Muons 10 MUON+ -99 100 100 =decay_tunnel -100 -100 0 100 100 100
STOP
EndInput

